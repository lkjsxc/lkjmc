[Unit]
Description=lkjmc daemon and managed Minecraft network
Wants=network-online.target
After=network-online.target postgresql.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
User=lkjmc
Group=lkjmc
EnvironmentFile=/etc/lkjmc/daemon.env
WorkingDirectory=/var/lib/lkjmc
ExecStartPre=+/opt/lkjmc/releases/current/bin/lkjmc-ops fence check --fence /etc/lkjmc/deployment-fence.json --permit /run/lkjmc-deploy-start-permit.json --trusted-root /
ExecStartPre=+/opt/lkjmc/releases/current/bin/lkjmc-ops eula materialize --config /etc/lkjmc/lkjmc.json
ExecStart=/opt/lkjmc/releases/current/bin/lkjmc-daemon --config /etc/lkjmc/lkjmc.json --http-token-file /etc/lkjmc/daemon-http.token
ExecStartPost=/opt/lkjmc/releases/current/bin/lkjmc --json bootstrap apply
ExecStartPost=/opt/lkjmc/releases/current/bin/lkjmc-ops bootstrap after-start --config /etc/lkjmc/lkjmc.json --cli /opt/lkjmc/releases/current/bin/lkjmc
Restart=on-failure
RestartSec=5
TimeoutStartSec=25min
TimeoutStopSec=2min
KillMode=mixed
RuntimeDirectory=lkjmc
RuntimeDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/lkjmc /var/log/lkjmc /run/lkjmc /opt/lkjmc/runtime-assets
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
