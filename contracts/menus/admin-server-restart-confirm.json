          "serverId": "@param.serverId"
        },
        "ok": "menu.admin.server.restart.ok",
        "fail": "menu.admin.server.restart.failed"
      }
    },
    {
      "slot": 15,
      "material": "RED_WOOL",
      "name": "menu.confirm.no",
      "lore": [],
      "role": "navigation",
      "action": {
        "type": "back"
      }
    }
  ],
  "confirmation": "forceful-server-mutation"
}
