{
  "id": "report-confirm",
  "kind": "confirm",
  "title": "menu.reports.confirm.resolve",
  "theme": "danger",
  "size": 27,
  "params": [
    {
      "name": "reportId",
      "required": true
    }
  ],
  "parent": "report-detail",
  "chrome": {
    "info": "menu.reports.confirm.resolve",
    "back": false,
    "refresh": false,
    "close": true,
    "mainMenu": false
  },
  "static": [
    {
      "slot": 11,
      "material": "LIME_WOOL",
      "name": "menu.confirm.yes",
      "lore": [],
      "role": "success",
      "action": {
        "type": "daemon",
        "command": "player.report.resolve",
        "body": {
          "reportId": "@param.reportId"
        },
        "ok": "reports.closed",
        "fail": "reports.close.failed"
      }
    },
    {
      "slot": 15,
      "material": "RED_WOOL",
      "name": "menu.confirm.no",
      "lore": [],
      "role": "navigation",
      "action": {
        "type": "back"
      }
    }
  ],
  "confirmation": "changes-moderation-state"
}
