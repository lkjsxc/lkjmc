{
  "id": "admin-server-create-confirm",
  "kind": "confirm",
  "title": "menu.admin.server.create.confirm",
  "theme": "staff",
  "size": 27,
  "params": [
    {
      "name": "kind",
      "required": true
    },
    {
      "name": "template",
      "required": true
    },
    {
      "name": "serverId",
      "required": true
    }
  ],
  "parent": "admin-server-create-template",
  "chrome": {
    "info": "menu.admin.server.create.confirm",
    "back": false,
    "refresh": false,
    "close": true,
    "mainMenu": false
  },
  "static": [
    {
      "slot": 11,
      "material": "LIME_WOOL",
      "name": "menu.confirm.yes",
      "lore": [],
      "role": "success",
      "action": {
        "type": "daemon",
        "command": "instance.create",
        "body": {
          "kind": "@param.kind",
          "template": "@param.template",
          "serverId": "@param.serverId"
        },
        "ok": "menu.admin.server.create.ok",
        "fail": "menu.admin.server.create.failed"
      }
    },
    {
      "slot": 15,
      "material": "RED_WOOL",
      "name": "menu.confirm.no",
      "lore": [],
      "role": "navigation",
      "action": {
        "type": "back"
      }
    }
  ],
  "confirmation": "starts-durable-resources"
}
