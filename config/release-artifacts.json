{
  "schemaVersion": 1,
  "artifacts": [
    {
      "component": "cli",
      "destination": "lkjmc",
      "kind": "binary",
      "source": "target/release/lkjmc"
    },
    {
      "component": "daemon",
      "destination": "lkjmc-daemon",
      "kind": "binary",
      "source": "target/release/lkjmc-daemon"
    },
    {
      "component": "discord",
      "destination": "lkjmc-discord",
      "kind": "binary",
      "source": "target/release/lkjmc-discord"
    },
    {
      "component": "release-deployer",
      "destination": "lkjmc-deploy-release",
      "kind": "binary",
      "source": "scripts/deploy-release.py"
    },
    {
      "component": "artifact-installer",
      "destination": "lkjmc-install-artifacts",
      "kind": "binary",
      "source": "scripts/install_artifacts.py"
    },
    {
      "component": "postgres-backup",
      "destination": "lkjmc-backup-postgres",
      "kind": "binary",
      "source": "scripts/backup-postgres.sh"
    },
    {
      "component": "postgres-restore",
      "destination": "lkjmc-restore-postgres",
      "kind": "binary",
      "source": "scripts/restore-postgres.sh"
    },
    {
      "component": "restart-reconciler",
      "destination": "lkjmc-bootstrap-after-start",
      "kind": "binary",
      "source": "packaging/lkjmc-bootstrap-after-start"
    },
    {
      "component": "deployment-fence-check",
      "destination": "lkjmc-deployment-fence-check",
      "kind": "binary",
      "source": "scripts/deployment-fence-check.py"
    },
    {
      "component": "systemd-service",
      "destination": "lkjmc-daemon.service",
      "kind": "config",
      "source": "packaging/lkjmc-daemon.service"
    },
    {
      "component": "deployment-fence",
      "destination": "lkjmc-deployment-fence.conf",
      "kind": "config",
      "source": "packaging/lkjmc-deployment-fence.conf"
    },
    {
      "component": "jvm-common",
      "destination": "lkjmc-common.jar",
      "kind": "jar",
      "source": "platforms/jvm/common/build/libs/common-all.jar"
    },
    {
      "component": "paper",
      "destination": "lkjmc-paper.jar",
      "kind": "jar",
      "source": "platforms/jvm/paper/build/libs/paper-all.jar"
    },
    {
      "component": "velocity",
      "destination": "lkjmc-velocity.jar",
      "kind": "jar",
      "source": "platforms/jvm/velocity/build/libs/velocity-all.jar"
    }
  ]
}
