{
  "schemaVersion": 1,
  "artifacts": [
    {
      "component": "cli",
      "destination": "lkjmc",
      "kind": "binary",
      "source": "target/release/lkjmc"
    },
    {
      "component": "daemon",
      "destination": "lkjmc-daemon",
      "kind": "binary",
      "source": "target/release/lkjmc-daemon"
    },
    {
      "component": "operations",
      "destination": "lkjmc-ops",
      "kind": "binary",
      "source": "target/release/lkjmc-ops"
    },
    {
      "component": "systemd-service",
      "destination": "lkjmc-daemon.service",
      "kind": "config",
      "source": "packaging/lkjmc-daemon.service"
    },
    {
      "component": "deployment-fence",
      "destination": "lkjmc-deployment-fence.conf",
      "kind": "config",
      "source": "packaging/lkjmc-deployment-fence.conf"
    },
    {
      "component": "jvm-common",
      "destination": "lkjmc-common.jar",
      "kind": "jar",
      "source": "platforms/jvm/common/build/libs/common-all.jar"
    },
    {
      "component": "paper",
      "destination": "lkjmc-paper.jar",
      "kind": "jar",
      "source": "platforms/jvm/paper/build/libs/paper-all.jar"
    },
    {
      "component": "velocity",
      "destination": "lkjmc-velocity.jar",
      "kind": "jar",
      "source": "platforms/jvm/velocity/build/libs/velocity-all.jar"
    }
  ]
}
